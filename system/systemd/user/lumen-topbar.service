[Unit]
Description=Lumen native Panorama topbar
After=graphical-session-pre.target plasma-kwin_wayland.service plasma-kded6.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=dbus
BusName=org.lumen.Topbar
ExecStart=%INSTALL_BIN%/lumen-topbar
# Applications launched from the bar must outlive a bar restart.
KillMode=process
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
