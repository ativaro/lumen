# opencode-agent.install — pacman install scriptlet
#
# Services are ENABLED BY DEFAULT (opt-out). They are safe to enable: none of
# them restart or stop shared system services (in particular, never D-Bus).
# Disable any time with the commands shown below.

post_install() {
    systemctl enable --now opencode-agentd.service 2>/dev/null || true
    systemctl enable --now opencode-agent-watch.timer 2>/dev/null || true
    # per-user units enabled for all users (opt-out via --global disable)
    systemctl --global enable opencode-agent-notify.path 2>/dev/null || true
    systemctl --global enable opencode-digest.timer 2>/dev/null || true
    systemctl --global enable opencode-nightly.timer 2>/dev/null || true
    # activate for the currently running user session, if any
    for d in /run/user/*/; do
        uid=$(basename "$d" 2>/dev/null); [ -z "$uid" ] && continue
        systemctl --machine="${uid}@.host" --user enable --now opencode-agent-notify.path 2>/dev/null || true
        systemctl --machine="${uid}@.host" --user enable --now opencode-digest.timer 2>/dev/null || true
        systemctl --machine="${uid}@.host" --user enable --now opencode-nightly.timer 2>/dev/null || true
    done

    cat <<'EOF'
opencode Agent installiert (Dateien systemweit unter /usr).

Dienste (standardmäßig AKTIV):
  opencode-agentd.service          - D-Bus org.opencode.Agent (Read-only-Systemstatus)
  opencode-agent-watch.timer       - System-Wächter (alle 15 min)
  opencode-agent-notify.path       - Desktop-Benachrichtigung (per Nutzer)
  opencode-digest.timer            - Tages-Digest (08:00)
  opencode-nightly.timer           - Nacht-Report (03:30)

Desktop-Integration unter /usr/share:
  - Anwendung "opencode Agent"
  - Dolphin-ServiceMenu "opencode"
  - KRunner-Runner (Trigger: ai <Frage>)
  - Plasma-Applet "opencode Agent" (Panel-Widget)
  - Global-Shortcuts: Meta+Shift+O (fragen), Meta+Shift+S (Zwischenablage)

Shell-Helfer (optional einbinden):
  source /usr/share/opencode-agent/shell/opencode.fish   # fish.config
  source /usr/share/opencode-agent/shell/opencode.bash   # ~/.bashrc
  -> why / vix / sel

Abschalten (opt-out):
  sudo systemctl disable --now opencode-agentd.service
  sudo systemctl disable --now opencode-agent-watch.timer
  sudo systemctl --global disable opencode-agent-notify.path
  sudo systemctl --global disable opencode-digest.timer opencode-nightly.timer
  systemctl --user disable --now opencode-agent-notify.path   # nur diese Sitzung

opencode-Commands/Skill:
  /usr/share/opencode-agent/opencode-command/
  /usr/share/opencode-agent/opencode-skill/

Nächste Schritte:
  1. opencode neu starten, damit Commands/Skill greifen.
  2. KRunner ggf. neu laden:  kquitapp6 krunner
EOF
}

post_upgrade() {
    # Do NOT re-enable here: a user who opted out must stay opted out.
    cat <<'EOF'
opencode Agent aktualisiert (bestehender Dienst-Zustand bleibt erhalten).

Falls der D-Bus-Dienst aktiv ist, neue Dateien übernehmen:
  sudo systemctl restart opencode-agentd.service
  systemctl --user try-restart opencode-agent-notify.path
Kein D-Bus-Neustart nötig – Policy-Änderungen werden automatisch geladen.
EOF
}

pre_remove() {
    systemctl disable --now opencode-agent-watch.timer 2>/dev/null || true
    systemctl disable --now opencode-agentd.service 2>/dev/null || true
    systemctl --global disable opencode-agent-notify.path 2>/dev/null || true
    for d in /run/user/*/; do
        uid=$(basename "$d" 2>/dev/null); [ -z "$uid" ] && continue
        systemctl --machine="${uid}@.host" --user disable --now opencode-agent-notify.path 2>/dev/null || true
    done
    systemctl --user disable --now opencode-agent-notify.path 2>/dev/null || true
}

post_remove() {
    rm -rf /var/lib/opencode-agent 2>/dev/null || true
    echo "opencode Agent entfernt."
}

pre_install() { :; }
pre_upgrade() { :; }
