# Maintainer: Lumen
pkgname=lumen
pkgver=1.2.0
pkgrel=23
pkgdesc="Lumen — AI desktop for CachyOS with files, tasks, knowledge and workflows"
provides=('opencode-lumen')
# No automatic conflict removal: the legacy package's uninstall script deletes reports.
# The supported build installer migrates it first; direct installation fails safely
# on file conflicts until the old package has been migrated.
arch=('any')
url="https://github.com/ativaro/lumen"
license=('MIT' 'GPL-3.0-only')
depends=('bash' 'python3' 'python-pyqt5' 'qt5-svg' 'python-gobject' 'python-pillow')
makedepends=()
# OpenCode may be installed through its own installer. Native files/tasks remain
# useful without inference; the app explains a missing engine when AI is requested.
optdepends=(
    'opencode: AI engine (or existing standalone OpenCode installation)'
    'whisper.cpp: optional offline dictation (whisper-cli and a local model)'
    'pipewire-audio: microphone recording for offline dictation'
    'qt6-tools: KWin window layout through qdbus6'
    'libnotify: watchdog/digest notifications'
    'spectacle: screenshot → vision (lumen-vision)'
    'nvidia-utils: GPU metrics'
    'python-dbus: KRunner runner and native Lumen shortcut settings'
    'dolphin: service menu integration'
    'plasma-workspace: KRunner integration'
    'wireplumber: native volume controls in the Lumen bar'
    'libpulse: selectable audio outputs and volume in Lumen work modes'
    'networkmanager: connection status in the Lumen bar'
    'systemsettings: native network, audio and display settings'
    'poppler: Lumen Files PDF preview and search (pdfinfo, pdftoppm, pdftotext)'
    'ffmpeg: Lumen Files video/audio preview (ffprobe, ffmpeg)'
    'kio-fuse: Lumen Files network folders (SMB/SFTP/WebDAV/NFS)'
    'kio-extras: Lumen Files network protocols'
    'kde-cli-tools: native SMB authentication dialogs before KIO-FUSE mounting'
)
backup=()
install="lumen.install"

# ---- source -----------------------------------------------------------------
# Two modes:
#  * PUBLISHED  (default): fetch the release tarball from the git host.
#  * LOCAL      (LOCALSRC=1): build from a tarball sitting next to this PKGBUILD.
# When publishing, replace _srcurl/_sha256 with the real values from the release
# (or run `updpkgsums`).
_srcurl="https://github.com/ativaro/lumen/archive/v$pkgver.tar.gz"

if [ "${LOCALSRC:-0}" = "1" ]; then
    source=("$pkgname-$pkgver.tar.gz")
    sha256sums=('SKIP')
else
    source=("$pkgname-$pkgver.tar.gz::$_srcurl")
    sha256sums=('SKIP')   # TODO: set the real checksum before publishing (updpkgsums)
fi

prepare() {
    cd "$srcdir"
    # The tarball contains the repo tree under a single top dir; flatten if needed.
    if [ -d "lumen-$pkgver" ]; then
        rm -rf "$pkgname-$pkgver.src" 2>/dev/null || true
    fi
}

package() {
    cd "$srcdir"

    # locate the extracted source root (tarball top dir)
    local srcroot
    if [ -d "lumen-$pkgver" ]; then
        srcroot="lumen-$pkgver"
    else
        srcroot="$(find . -maxdepth 1 -type d -name "$pkgname-$pkgver" | head -1)"
        srcroot="${srcroot:-.}"
    fi

    # ---- program binaries -------------------------------------------------
    install -d "$pkgdir/usr/bin"
    install -m0755 "$srcroot/bin/"* "$pkgdir/usr/bin/"

    # system daemon + watchdog + notifier
    install -m0755 "$srcroot/system/lumen-agentd.py" "$pkgdir/usr/bin/lumen-agentd"
    install -m0755 "$srcroot/system/lumen-watch" "$pkgdir/usr/bin/lumen-watch"
    install -m0755 "$srcroot/system/lumen-notify" "$pkgdir/usr/bin/lumen-notify"

    # ---- native desktop app -------------------------------------------
    install -d "$pkgdir/usr/share/lumen/agent-app"
    install -m0644 "$srcroot/agent-app/main.py" "$pkgdir/usr/share/lumen/agent-app/"

    # ---- desktop integration (system-wide) --------------------------------
    # Templates use %INSTALL_BIN%; substitute to /usr/bin for a system install.
    sub() { sed 's|%INSTALL_BIN%|/usr/bin|g' "$1" > "$2"; }

    install -d "$pkgdir/usr/share/applications"
    sub "$srcroot/data/applications/lumen.desktop" "$pkgdir/usr/share/applications/lumen.desktop"
    sub "$srcroot/data/applications/lumen-ask.desktop" "$pkgdir/usr/share/applications/lumen-ask.desktop"
    sub "$srcroot/data/applications/lumen-ask-sel.desktop" "$pkgdir/usr/share/applications/lumen-ask-sel.desktop"
    sub "$srcroot/data/applications/lumen-vision.desktop" "$pkgdir/usr/share/applications/lumen-vision.desktop"
    sub "$srcroot/data/applications/lumen-sel.desktop" "$pkgdir/usr/share/applications/lumen-sel.desktop"
    sub "$srcroot/data/applications/lumen-files.desktop" "$pkgdir/usr/share/applications/lumen-files.desktop"

    install -d "$pkgdir/usr/share/kio/servicemenus"
    sub "$srcroot/data/kio-servicemenus/lumen.desktop" "$pkgdir/usr/share/kio/servicemenus/lumen.desktop"

    install -d "$pkgdir/usr/share/krunner/dbusplugins"
    install -m0644 "$srcroot/data/krunner-dbusplugins/lumen-runner.desktop" "$pkgdir/usr/share/krunner/dbusplugins/"

    install -d "$pkgdir/usr/share/dbus-1/services"
    sub "$srcroot/data/dbus-1-services/org.lumen.runner.service" "$pkgdir/usr/share/dbus-1/services/org.lumen.runner.service"

    install -d "$pkgdir/etc/xdg/autostart"
    sub "$srcroot/data/autostart/lumen-krunner-runner.desktop" "$pkgdir/etc/xdg/autostart/lumen-krunner-runner.desktop"

    # ---- systemd ----------------------------------------------------------
    install -d "$pkgdir/usr/lib/systemd/system"
    install -m0644 "$srcroot/system/systemd/lumen-agentd.service" "$pkgdir/usr/lib/systemd/system/"
    install -m0644 "$srcroot/system/systemd/lumen-watch.service" "$pkgdir/usr/lib/systemd/system/"
    install -m0644 "$srcroot/system/systemd/lumen-watch.timer" "$pkgdir/usr/lib/systemd/system/"

    install -d "$pkgdir/usr/lib/systemd/user"
    install -m0644 "$srcroot/system/systemd/user/lumen-notify.service" "$pkgdir/usr/lib/systemd/user/"
    install -m0644 "$srcroot/system/systemd/user/lumen-notify.path" "$pkgdir/usr/lib/systemd/user/"
    install -m0644 "$srcroot/system/systemd/user/lumen-digest.service" "$pkgdir/usr/lib/systemd/user/"
    install -m0644 "$srcroot/system/systemd/user/lumen-digest.timer" "$pkgdir/usr/lib/systemd/user/"
    install -m0644 "$srcroot/system/systemd/user/lumen-nightly.service" "$pkgdir/usr/lib/systemd/user/"
    install -m0644 "$srcroot/system/systemd/user/lumen-nightly.timer" "$pkgdir/usr/lib/systemd/user/"
    install -m0644 "$srcroot/system/systemd/user/lumen-jobs.timer" "$pkgdir/usr/lib/systemd/user/"
    sub "$srcroot/system/systemd/user/lumen-jobs.service" "$pkgdir/usr/lib/systemd/user/lumen-jobs.service"
    # substitute %INSTALL_BIN% in the user unit templates we just copied
    for u in lumen-digest.service lumen-nightly.service; do
        sub "$srcroot/system/systemd/user/$u" "$pkgdir/usr/lib/systemd/user/$u"
    done

    # ---- shell integration ------------------------------------------------
    install -d "$pkgdir/usr/share/lumen/shell"
    install -m0644 "$srcroot/shell/lumen.bash" "$pkgdir/usr/share/lumen/shell/"
    install -m0644 "$srcroot/shell/lumen.fish" "$pkgdir/usr/share/lumen/shell/"

    ln -s lumen "$pkgdir/usr/share/opencode-lumen"

    # ---- Lumen Files (file manager) ---------------------------------------
    install -d "$pkgdir/usr/share/lumen/files"
    install -m0644 "$srcroot/files/"*.py "$pkgdir/usr/share/lumen/files/"
    install -m0644 "$srcroot/files/"*.qss "$pkgdir/usr/share/lumen/files/"
    install -m0644 "$srcroot/files/"*.svg "$pkgdir/usr/share/lumen/files/"
    install -m0755 "$srcroot/bin/lumen-files" "$pkgdir/usr/bin/lumen-files"

    # Portable artwork and fresh-desktop setup; no developer-machine configuration.
    install -d "$pkgdir/usr/share/lumen/desktop"
    cp -R "$srcroot/desktop/." "$pkgdir/usr/share/lumen/desktop/"

    # ---- Plasma applet (plasmoid) -----------------------------------------
    for plugin in agent islands system search control; do
        local applet="$pkgdir/usr/share/plasma/plasmoids/org.lumen.$plugin"
        install -d "$applet/contents/ui" "$applet/contents/config"
        local metadata=metadata.json
        [[ "$plugin" == agent ]] || metadata="$plugin-metadata.json"
        install -m0644 "$srcroot/plasmoid/$metadata" "$applet/metadata.json"
        install -m0644 "$srcroot/plasmoid/contents/ui/"*.qml "$applet/contents/ui/"
        install -m0644 "$srcroot/plasmoid/contents/config/"* "$applet/contents/config/"
        local surface=tasks
        case "$plugin" in system) surface=home;; search|control) surface="$plugin";; esac
        sed -i "s|<default>tasks</default>|<default>$surface</default>|" "$applet/contents/config/main.xml"
    done

    # ---- system D-Bus policy + activation ---------------------------------
    install -d "$pkgdir/usr/share/dbus-1/system.d"
    install -m0644 "$srcroot/system/dbus-1/org.lumen.Agent.conf" "$pkgdir/usr/share/dbus-1/system.d/"
    install -d "$pkgdir/usr/share/dbus-1/system-services"
    install -m0644 "$srcroot/system/dbus-1/system-services/org.lumen.Agent.service" "$pkgdir/usr/share/dbus-1/system-services/"

    # ---- opencode commands / skill (system-wide share) --------------------
    install -d "$pkgdir/usr/share/lumen/opencode-command"
    install -m0644 "$srcroot/opencode-command/"*.md "$pkgdir/usr/share/lumen/opencode-command/" 2>/dev/null || true
    install -d "$pkgdir/usr/share/lumen/opencode-skill/lumen-admin"
    install -m0644 "$srcroot/opencode-skill/lumen-admin/SKILL.md" "$pkgdir/usr/share/lumen/opencode-skill/lumen-admin/" 2>/dev/null || true

    # ---- icons ------------------------------------------------------------
    install -d "$pkgdir/usr/share/icons/hicolor/scalable/apps"
    install -m0644 "$srcroot/icons/hicolor/scalable/apps/lumen.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/lumen.svg"
    install -m0644 "$srcroot/icons/hicolor/scalable/apps/lumen-files.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/lumen-files.svg"

    # ---- state directory (owned by root, world-readable findings) ---------
    install -d -m0755 "$pkgdir/var/lib/lumen"

    # ---- license ----------------------------------------------------------
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    install -m0644 "$srcroot/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/"
    install -m0644 "$srcroot/desktop/COPYING.GPL-3.0" "$srcroot/desktop/CREDITS.md" "$pkgdir/usr/share/licenses/$pkgname/"
}
