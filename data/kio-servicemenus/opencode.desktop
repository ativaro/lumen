[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;inode/directory;
Actions=opencodeOpen;opencodeExplain;opencodeFix;opencodeReview;opencodeAsk;

X-KDE-Priority=TopLevel
X-KDE-Submenu=opencode
Icon=opencode

[Desktop Action opencodeOpen]
Name=Mit opencode öffnen
Icon=utilities-terminal
Exec=%INSTALL_BIN%/opencode-context open %F

[Desktop Action opencodeExplain]
Name=opencode: erklären
Icon=help-contents
Exec=%INSTALL_BIN%/opencode-context explain %F

[Desktop Action opencodeFix]
Name=opencode: Fehler suchen & fixen
Icon=system-run
Exec=%INSTALL_BIN%/opencode-context fix %F

[Desktop Action opencodeReview]
Name=opencode: git-Änderungen reviewen
Icon=vcs-normal
Exec=%INSTALL_BIN%/opencode-context review %F

[Desktop Action opencodeAsk]
Name=opencode: fragen …
Icon=system-search
Exec=%INSTALL_BIN%/opencode-context ask %F
