QWidget#wissenShell { background: palette(window); }
QWidget#wissenChrome { border-bottom: 1px solid palette(mid); }
QLabel#wissenBrand { font-size: 14px; font-weight: 500; }
QWidget#wissenNavigation { background: palette(base); }
QPushButton#wissenArea { background: transparent; color: palette(text); border: 1px solid transparent; border-radius: 8px; padding: 10px 8px; text-align: left; font-size: 13px; }
QPushButton#wissenArea:checked, QPushButton#wissenArea:hover { background: palette(midlight); color: palette(text); }
QPushButton#wissenArea:focus { border-color: palette(link); }
QLabel#wissenCaption { color: palette(dark); font-size: 11px; padding: 22px 8px 8px; }
QListWidget#wissenCollections { background: transparent; border: none; font-size: 13px; }
QListWidget#wissenCollections::item { padding: 9px 8px; border-radius: 7px; color: palette(text); }
QListWidget#wissenCollections::item:selected { background: palette(midlight); }
QWidget#wissenPaper { background: palette(base); }
QTabWidget#wissenPages::pane { border: none; }
QTabWidget#wissenPages > QWidget { background: palette(base); }
QLineEdit#wissenTitle { background: transparent; border: none; border-radius: 0; padding: 10px 0; font-size: 25px; font-weight: 500; }
QLineEdit#wissenTitle:focus { border: none; }
QPlainTextEdit#wissenEditor, QTextBrowser#wissenPreview { background: transparent; border: none; border-radius: 0; padding: 0; font-size: 16px; }
QScrollArea#wissenDetails { background: palette(base); border: none; border-top: 1px solid palette(mid); }
QScrollArea#wissenDetails QWidget { background: palette(base); }
