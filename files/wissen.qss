QWidget#wissenShell { background: palette(window); color: palette(text); }
QWidget#wissenShell QLabel { background: transparent; color: palette(text); }
QWidget#wissenShell QLabel#muted { color: palette(placeholder-text); font-size: 12px; }
QWidget#wissenNavigation, QWidget#wissenList { background: palette(window); }
QWidget#wissenList { border-left: 1px solid palette(mid); }
QLabel#wissenCaption { color: palette(placeholder-text); font-size: 11px; letter-spacing: 1.5px; padding: 16px 10px 4px; }
QWidget#wissenShell QPushButton { background: transparent; color: palette(text); border: 1px solid transparent; border-radius: 8px; padding: 8px 12px; font-size: 14px; }
QWidget#wissenShell QPushButton:hover { background: palette(alternate-base); }
QWidget#wissenShell QPushButton:focus { border-color: palette(highlight); }
QWidget#wissenShell QPushButton:checked { background: palette(alternate-base); }
QWidget#wissenShell QPushButton:disabled { color: palette(placeholder-text); }
QWidget#wissenShell QPushButton#primary { background: palette(highlight); color: palette(highlighted-text); padding: 10px 18px; }
QWidget#wissenShell QPushButton#primary:disabled { background: palette(alternate-base); color: palette(placeholder-text); }
QWidget#wissenNavigation QPushButton { text-align: left; }
QWidget#wissenShell QLineEdit, QWidget#wissenShell QComboBox { background: palette(window); color: palette(text); border: 1px solid palette(mid); border-radius: 8px; padding: 10px 14px; min-width: 0; selection-background-color: palette(highlight); selection-color: palette(highlighted-text); }
QWidget#wissenShell QLineEdit:focus, QWidget#wissenShell QComboBox:focus { border-color: palette(highlight); }
QWidget#wissenShell QComboBox::drop-down { border: none; width: 20px; }
QListWidget#wissenCollections { background: transparent; border: none; font-size: 14px; }
QListWidget#wissenCollections::item { padding: 10px; border-radius: 0; color: palette(text); }
QListWidget#wissenCollections::item:selected { background: palette(alternate-base); }
QListWidget#wissenCollections::item:hover { background: palette(alternate-base); }
QWidget#wissenShell QListWidget#searchResults { background: transparent; border: none; padding: 0; }
QWidget#wissenPaper, QWidget#wissenWriting { background: palette(base); border-radius: 10px; }
QTabWidget#wissenPages::pane { border: none; }
QTabWidget#wissenPages > QWidget { background: palette(base); }
QWidget#wissenShell QLineEdit#wissenTitle { background: transparent; border: none; border-radius: 0; padding: 10px 0; font-size: 24px; font-weight: 500; }
QWidget#notesDocument { border: 1px solid palette(mid); border-radius: 12px; background: palette(base); }
QTextEdit#wissenRichEditor, QPlainTextEdit#wissenEditor, QTextBrowser#wissenPreview { background: palette(base); color: palette(text); border: none; border-radius: 12px; padding: 24px 32px; font-size: 14px; selection-background-color: palette(highlight); selection-color: palette(highlighted-text); }
QTextEdit#wissenRichEditor:focus { border: 1px solid palette(highlight); }
QScrollArea#wissenDetails { background: palette(base); border: none; border-top: 1px solid palette(mid); }
QScrollArea#wissenDetails QWidget { background: palette(base); }
QPushButton#memoryProfileEntry { background: palette(base); color: palette(text); border: 1px solid palette(mid); border-radius: 8px; text-align: left; min-height: 72px; }
QPushButton#memoryProfileEntry:hover, QPushButton#memoryProfileEntry:focus { border-color: palette(highlight); background: palette(alternate-base); }
QToolBar#notesToolbar { background: palette(base); border: none; border-bottom: 1px solid palette(mid); border-top-left-radius: 12px; border-top-right-radius: 12px; spacing: 4px; padding: 10px; }
QToolBar#notesToolbar QToolButton { color: palette(text); min-width: 20px; min-height: 20px; padding: 8px; border: 1px solid transparent; border-radius: 0; }
QToolBar#notesToolbar QToolButton:hover, QToolBar#notesToolbar QToolButton:focus { background: palette(alternate-base); border-color: palette(highlight); }
QToolBar#notesToolbar QToolButton:checked { background: palette(alternate-base); }
QToolBar#notesToolbar QToolButton::menu-indicator { image: none; width: 0; }
QToolBar#notesToolbar QComboBox#notesParagraph { min-width: 130px; max-width: 160px; }
QToolBar#notesToolbar::separator { background: palette(mid); width: 1px; margin: 6px 3px; }
QToolBar#notesToolbar QToolButton#qt_toolbar_ext_button { padding: 0; border: 1px solid palette(mid); font-size: 20px; min-width: 24px; }
QToolBar#notesTableTools { background: palette(base); border: none; spacing: 2px; padding: 6px; }
QToolBar#notesTableTools QToolButton { color: palette(text); padding: 8px; border: 1px solid transparent; border-radius: 6px; font-size: 11px; }
QToolBar#notesTableTools QToolButton:hover { background: palette(alternate-base); }
QToolBar#notesTableTools QToolButton:disabled { color: palette(placeholder-text); }
QWidget#wissenShell QPushButton#noteTagChip { background: palette(alternate-base); color: palette(highlight); border: 1px solid palette(mid); border-radius: 12px; padding: 4px 10px; }
QScrollArea#noteTagsScroll, QWidget#noteTagsChips { background: transparent; border: none; }
QWidget#notesSave { border-top: 1px solid palette(mid); }
QSplitter::handle, QSplitter#notesLiveSplit::handle { background: palette(mid); }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: palette(mid); border-radius: 4px; min-height: 28px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
