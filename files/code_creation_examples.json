{
  "compare": "<!doctype html><html lang=\"de\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{font:16px system-ui;margin:28px;color:#24322c;background:#f5f7f4}h1{font-size:24px}label{display:block;margin:14px 0}input,button{font:inherit;padding:9px;border:1px solid #a5b5ab;border-radius:7px;background:white}input[type=number]{width:110px}button{cursor:pointer}output{display:block;margin:20px 0;padding:18px;border-radius:10px;background:#dfeae0;font-size:21px}li{margin:12px 0}small{display:block;color:#56665a;margin-top:28px}</style><h1>Angebotsvergleich</h1><p>Zwei Beispielangebote vergleichen. Preise in derselben Währung eingeben.</p><label>Angebot A <input id=\"a\" type=\"number\" min=\"0\" step=\"0.01\" value=\"120\"></label><label>Angebot B <input id=\"b\" type=\"number\" min=\"0\" step=\"0.01\" value=\"95\"></label><output id=\"out\"></output><script>function calc(){let a=Number(document.querySelector('#a').value),b=Number(document.querySelector('#b').value);document.querySelector('#out').textContent=(!Number.isFinite(a)||!Number.isFinite(b)||a<0||b<0)?'Bitte gültige Preise eingeben.':a===b?'Beide kosten gleich viel.':(a<b?'Angebot A':'Angebot B')+' ist um '+Math.abs(a-b).toLocaleString('de-CH',{minimumFractionDigits:2,maximumFractionDigits:2})+' günstiger.'}document.addEventListener('input',calc);calc();</script><small>Ausprobierbares Beispiel · Eingaben bleiben nur bis zum Schließen erhalten.</small></html>",
  "packing": "<!doctype html><html lang=\"de\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{font:16px system-ui;margin:28px;color:#24322c;background:#f5f7f4}h1{font-size:24px}label{display:block;margin:14px 0}input,button{font:inherit;padding:9px;border:1px solid #a5b5ab;border-radius:7px;background:white}input[type=number]{width:110px}button{cursor:pointer}output{display:block;margin:20px 0;padding:18px;border-radius:10px;background:#dfeae0;font-size:21px}li{margin:12px 0}small{display:block;color:#56665a;margin-top:28px}</style><h1>Meine Packliste</h1><p>Hake die Dinge ab, die du eingepackt hast.</p><ul id=\"list\"><li><label><input type=\"checkbox\"> Ladekabel</label></li><li><label><input type=\"checkbox\"> Ausweis</label></li><li><label><input type=\"checkbox\"> Jacke</label></li></ul><form id=\"form\"><label>Eigener Gegenstand <input id=\"item\" maxlength=\"100\" required></label><button>Hinzufügen</button></form><output id=\"out\"></output><script>function count(){let all=document.querySelectorAll('#list input'),done=document.querySelectorAll('#list input:checked');document.querySelector('#out').textContent=done.length+' von '+all.length+' eingepackt'}document.addEventListener('change',count);document.querySelector('#form').addEventListener('submit',e=>{e.preventDefault();let text=document.querySelector('#item');if(!text.value.trim())return;let li=document.createElement('li'),label=document.createElement('label'),box=document.createElement('input');box.type='checkbox';label.append(box,document.createTextNode(' '+text.value.trim()));li.append(label);document.querySelector('#list').append(li);text.value='';count()});count();</script><small>Ausprobierbares Beispiel · Eingaben bleiben nur bis zum Schließen erhalten.</small></html>",
  "budget": "<!doctype html><html lang=\"de\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{font:16px system-ui;margin:28px;color:#24322c;background:#f5f7f4}h1{font-size:24px}label{display:block;margin:14px 0}input,button{font:inherit;padding:9px;border:1px solid #a5b5ab;border-radius:7px;background:white}input[type=number]{width:110px}button{cursor:pointer}output{display:block;margin:20px 0;padding:18px;border-radius:10px;background:#dfeae0;font-size:21px}li{margin:12px 0}small{display:block;color:#56665a;margin-top:28px}</style><h1>Projektbudget</h1><p>Budget und Ausgaben in derselben Währung eingeben.</p><label>Budget <input id=\"budget\" type=\"number\" min=\"0\" step=\"0.01\" value=\"1000\"></label><label>Geplante Ausgaben <input id=\"expense\" type=\"number\" min=\"0\" step=\"0.01\" value=\"650\"></label><output id=\"out\"></output><script>function calc(){let a=Number(document.querySelector('#budget').value),b=Number(document.querySelector('#expense').value),out=document.querySelector('#out');out.textContent=(!Number.isFinite(a)||!Number.isFinite(b)||a<0||b<0)?'Bitte gültige Beträge eingeben.':(a>=b?'Noch verfügbar: ':'Budget überschritten um ')+Math.abs(a-b).toLocaleString('de-CH',{minimumFractionDigits:2,maximumFractionDigits:2});out.style.background=a>=b?'#dfeae0':'#ffdfd2'}document.addEventListener('input',calc);calc();</script><small>Ausprobierbares Beispiel · Eingaben bleiben nur bis zum Schließen erhalten.</small></html>",
  "compare-en": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{font:16px system-ui;margin:28px;color:#24322c;background:#f5f7f4}h1{font-size:24px}label{display:block;margin:14px 0}input,button{font:inherit;padding:9px;border:1px solid #a5b5ab;border-radius:7px;background:white}input[type=number]{width:110px}button{cursor:pointer}output{display:block;margin:20px 0;padding:18px;border-radius:10px;background:#dfeae0;font-size:21px}li{margin:12px 0}small{display:block;color:#56665a;margin-top:28px}</style><h1>Quote comparison</h1><p>Compare two example quotes. Enter prices in the same currency.</p><label>Quote A <input id=\"a\" type=\"number\" min=\"0\" step=\"0.01\" value=\"120\"></label><label>Quote B <input id=\"b\" type=\"number\" min=\"0\" step=\"0.01\" value=\"95\"></label><output id=\"out\"></output><script>function calc(){let a=Number(document.querySelector('#a').value),b=Number(document.querySelector('#b').value);document.querySelector('#out').textContent=(!Number.isFinite(a)||!Number.isFinite(b)||a<0||b<0)?'Enter valid prices.':a===b?'Both cost the same.':(a<b?'Quote A':'Quote B')+' costs '+Math.abs(a-b).toLocaleString('de-CH',{minimumFractionDigits:2,maximumFractionDigits:2})+' less.'}document.addEventListener('input',calc);calc();</script><small>Working example · inputs last until you close it.</small></html>",
  "packing-en": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{font:16px system-ui;margin:28px;color:#24322c;background:#f5f7f4}h1{font-size:24px}label{display:block;margin:14px 0}input,button{font:inherit;padding:9px;border:1px solid #a5b5ab;border-radius:7px;background:white}input[type=number]{width:110px}button{cursor:pointer}output{display:block;margin:20px 0;padding:18px;border-radius:10px;background:#dfeae0;font-size:21px}li{margin:12px 0}small{display:block;color:#56665a;margin-top:28px}</style><h1>My packing list</h1><p>Check off the items you have packed.</p><ul id=\"list\"><li><label><input type=\"checkbox\"> Charger</label></li><li><label><input type=\"checkbox\"> ID card</label></li><li><label><input type=\"checkbox\"> Jacket</label></li></ul><form id=\"form\"><label>Your own item <input id=\"item\" maxlength=\"100\" required></label><button>Add</button></form><output id=\"out\"></output><script>function count(){let all=document.querySelectorAll('#list input'),done=document.querySelectorAll('#list input:checked');document.querySelector('#out').textContent=done.length+' of '+all.length+' packed'}document.addEventListener('change',count);document.querySelector('#form').addEventListener('submit',e=>{e.preventDefault();let text=document.querySelector('#item');if(!text.value.trim())return;let li=document.createElement('li'),label=document.createElement('label'),box=document.createElement('input');box.type='checkbox';label.append(box,document.createTextNode(' '+text.value.trim()));li.append(label);document.querySelector('#list').append(li);text.value='';count()});count();</script><small>Working example · inputs last until you close it.</small></html>",
  "budget-en": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><style>body{font:16px system-ui;margin:28px;color:#24322c;background:#f5f7f4}h1{font-size:24px}label{display:block;margin:14px 0}input,button{font:inherit;padding:9px;border:1px solid #a5b5ab;border-radius:7px;background:white}input[type=number]{width:110px}button{cursor:pointer}output{display:block;margin:20px 0;padding:18px;border-radius:10px;background:#dfeae0;font-size:21px}li{margin:12px 0}small{display:block;color:#56665a;margin-top:28px}</style><h1>Project budget</h1><p>Enter the budget and expenses in the same currency.</p><label>Budget <input id=\"budget\" type=\"number\" min=\"0\" step=\"0.01\" value=\"1000\"></label><label>Planned expenses <input id=\"expense\" type=\"number\" min=\"0\" step=\"0.01\" value=\"650\"></label><output id=\"out\"></output><script>function calc(){let a=Number(document.querySelector('#budget').value),b=Number(document.querySelector('#expense').value),out=document.querySelector('#out');out.textContent=(!Number.isFinite(a)||!Number.isFinite(b)||a<0||b<0)?'Enter valid amounts.':(a>=b?'Remaining: ':'Budget exceeded by ')+Math.abs(a-b).toLocaleString('de-CH',{minimumFractionDigits:2,maximumFractionDigits:2});out.style.background=a>=b?'#dfeae0':'#ffdfd2'}document.addEventListener('input',calc);calc();</script><small>Working example · inputs last until you close it.</small></html>"
}
