#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
for main in "$SELF_DIR/../files/lumen_tasks.py" "$SELF_DIR/../share/lumen/files/lumen_tasks.py" /usr/share/lumen/files/lumen_tasks.py; do
    if [[ -f "$main" ]]; then exec "$SELF_DIR/lumen-python" "$main" "$@"; fi
done
echo 'Lumen-Aufträge sind nicht installiert.' >&2
exit 1
