#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
lab="${XDG_DATA_HOME:-$HOME/.local/share}/lumen/vault-lab/bin/lumen-vault-lab"
if [[ "$#" == 0 && -x "$lab" ]]; then exec "$lab" --laboratory-only; fi
if [[ "${1:-}" == "--backups" ]]; then shift; fi
if [[ "${1:-}" == "--lab" ]]; then
    [[ "$#" == 1 ]] || exit 2
    lab="${XDG_DATA_HOME:-$HOME/.local/share}/lumen/vault-lab/bin/lumen-vault-lab"
    if [[ -x "$lab" ]]; then exec "$lab" --laboratory-only; fi
    echo 'Die native Tresor-Testversion ist nicht installiert. Sie ist noch nicht für echte Zugangsdaten freigegeben.' >&2
    exit 1
fi
module=tools_app.py
args=(vault "$@")
if [[ "${1:-}" == "--preview" ]]; then
    shift
    module=vault_preview.py
    args=("$@")
fi
for main in "$SELF_DIR/../files/$module" "$SELF_DIR/../share/lumen/files/$module" /usr/share/lumen/files/$module; do
    if [ -f "$main" ]; then exec "$SELF_DIR/lumen-python" "$main" "${args[@]}"; fi
done
echo 'Die Anwendung wurde nicht gefunden. Bitte die Lumen-Installation prüfen.' >&2
exit 1
