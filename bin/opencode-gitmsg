#!/usr/bin/env bash
# opencode-gitmsg — generate a commit message from the staged/unstaged diff.
#
# Usage:
#   opencode-gitmsg            # print a suggested message to stdout
#   opencode-gitmsg --commit   # generate and open the editor with it preloaded
#   opencode-gitmsg --apply    # write it to .git/COMMIT_EDITMSG (for hooks)
#
# Env: OPENCODE_BIN, OPENCODE_GITMSG_STYLE, OPENCODE_GITMSG_MODEL

set -euo pipefail

OPENCODE_BIN="${OPENCODE_BIN:-$(command -v opencode || echo "$HOME/.opencode/bin/opencode")}"
STYLE="${OPENCODE_GITMSG_STYLE:-Conventional Commits (type(scope): summary), englisch, Imperativ, max 72 Zeichen in der Betreffzeile, danach ein kurzer Body mit den wichtigsten Punkten}"

mode="${1:-print}"

# gather context
diff="$(git diff --cached 2>/dev/null)"
if [ -z "$diff" ]; then
    diff="$(git diff 2>/dev/null)"
fi
status="$(git status --short 2>/dev/null)"
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"

if [ -z "$diff" ] && [ -z "$status" ]; then
    echo "Keine Änderungen gefunden (nicht in einem Git-Repo?)." >&2
    exit 1
fi

prompt="Erzeuge eine Commit-Message für die folgenden Änderungen.
Stil: ${STYLE}.
Gib NUR die Commit-Message aus (keine Erklärungen, keine Codeblöcke).

Branch: ${branch}
git status:
${status}

Diff (gekürzt):
$(printf '%s' "$diff" | head -c 12000)"

model_args=()
[ -n "${OPENCODE_GITMSG_MODEL:-}" ] && model_args=(--model "$OPENCODE_GITMSG_MODEL")

msg="$(env -u OPENCODE -u OPENCODE_PID timeout 120 "$OPENCODE_BIN" run "${model_args[@]}" "$prompt" </dev/null 2>/dev/null \
    | sed -e 's/\x1b\[[0-9;]*m//g' | sed '/^[[:space:]]*$/d')"

[ -z "$msg" ] && { echo "Keine Message erzeugt." >&2; exit 1; }

case "$mode" in
    print)  printf '%s\n' "$msg" ;;
    --apply)
        gitdir="$(git rev-parse --git-dir)"
        printf '%s\n' "$msg" > "$gitdir/COMMIT_EDITMSG"
        printf '%s\n' "$msg"
        ;;
    --commit)
        git commit -e -m "$msg" ;;
    *) echo "Unbekannter Modus: $mode" >&2; exit 2 ;;
esac
