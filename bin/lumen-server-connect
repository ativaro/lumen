#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
main=lumen_connect_gui.py
if [ "${1:-}" = --watch ]; then main=lumen_connect.py; shift; set -- watch "$@"; fi
for folder in "$SELF_DIR/../files" "$SELF_DIR/../share/lumen/files" /usr/share/lumen/files; do
    if [ -f "$folder/$main" ]; then
        export LUMEN_DESKTOP_FILES="$folder"
        exec "$SELF_DIR/lumen-python" "$folder/$main" "$@"
    fi
done
echo 'Lumen: Server connection component not found.' >&2
exit 1
