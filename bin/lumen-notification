#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
for main in "$SELF_DIR/../files/lumen_notifications.py" "$SELF_DIR/../share/lumen/files/lumen_notifications.py" /usr/share/lumen/files/lumen_notifications.py; do
    if [ -f "$main" ]; then exec "$SELF_DIR/lumen-python" "$main" "$@"; fi
done
echo 'Lumen Notification wurde nicht gefunden.' >&2
exit 1
