#!/usr/bin/env bash
# lumen-context — helper for KDE Dolphin service menus and Lumen Files.
# Opens a terminal running opencode ("Lumen") about the selected file(s).
#
# Usage:
#   lumen-context <action> <path>...
#   action: open | explain | fix | review | ask
#
# Design:
#   * open   -> a NEW interactive session in the target directory (never --continue)
#   * others -> interactive session prefilled with a short prompt, so permission
#               prompts can be approved and the user can keep chatting
#
# Overridable via environment / config:
#   LUMEN_OPENCODE_BIN   path to the opencode binary (default: auto-detect)
#   LUMEN_TERM           terminal emulator (default: auto-detect)
#   LUMEN_WORKDIR        default working directory (default: ~/Documents/work)

set -euo pipefail

# ---- configuration --------------------------------------------------------
LUMEN_OPENCODE_BIN="${LUMEN_OPENCODE_BIN:-$(command -v opencode || echo "$HOME/.opencode/bin/opencode")}"
LUMEN_TERM="${LUMEN_TERM:-$(command -v alacritty || command -v konsole || command -v xterm)}"
LUMEN_WORKDIR="${LUMEN_WORKDIR:-$HOME/Documents/work}"
TERM_BIN="$(command -v "$LUMEN_TERM" 2>/dev/null || echo "$LUMEN_TERM")"
TITLE_PREFIX="Lumen"

term_run() {
    # $1 = title, $2 = shell command string (run in $LUMEN_WORKDIR)
    local title="$1" shellcmd="$2"
    case "$(basename "$TERM_BIN")" in
        alacritty) exec "$TERM_BIN" --working-directory "$LUMEN_WORKDIR" -T "$title" -e bash -lc "$shellcmd" ;;
        konsole)   exec "$TERM_BIN" --workdir "$LUMEN_WORKDIR" -p tabtitle="$title" -e bash -lc "$shellcmd" ;;
        xterm)     exec "$TERM_BIN" -T "$title" -e bash -lc "cd '$LUMEN_WORKDIR' && $shellcmd" ;;
        *)         exec "$TERM_BIN" -e bash -lc "cd '$LUMEN_WORKDIR' && $shellcmd" ;;
    esac
}

action="${1:-open}"
shift || true
paths=("$@")

if [ ${#paths[@]} -eq 0 ]; then
    paths=("$PWD")
fi

first="${paths[0]}"
if [ -d "$first" ]; then
    workdir="$first"
    is_dir=1
else
    workdir="$(dirname "$first")"
    is_dir=0
fi
LUMEN_WORKDIR="$workdir"

case "$action" in
    open)
        # Brand-new interactive session in the target directory.
        term_run "$TITLE_PREFIX: ${first##*/}" \
            '"$LUMEN_OPENCODE_BIN" "$PWD"'
        ;;

    explain)
        if [ "$is_dir" = "1" ]; then
            prompt="Erkläre in 2–3 kurzen Sätzen, was dieser Ordner enthält und wozu er dient. Keine technischen Details. Beende deine Antwort mit genau einer Frage: „Soll ich mehr erklären?“  Ordner: $first"
        else
            prompt="Erkläre in 2–3 kurzen Sätzen, was diese Datei macht und wozu sie dient. Keine technischen Details. Beende deine Antwort mit genau einer Frage: „Soll ich mehr erklären?“  Datei: $first"
        fi
        mode="erklären"
        ;;

    fix)
        if [ "$is_dir" = "1" ]; then
            prompt="Prüfe diesen Ordner auf Fehler und behebe sie. Frage bei Unsicherheit nach. Fasse am Ende in 1–2 Sätzen zusammen, was du geändert hast. Ordner: $first"
        else
            prompt="Prüfe diese Datei auf Fehler und behebe sie. Frage bei Unsicherheit nach. Fasse am Ende in 1–2 Sätzen zusammen, was du geändert hast. Datei: $first"
        fi
        mode="fixen"
        ;;

    review)
        prompt="Reviewe die aktuellen git-Änderungen in diesem Repository (git diff + git status). Nenne kurz die wichtigsten Punkte. Verzeichnis: $workdir"
        mode="review"
        ;;

    ask)
        target="$first"
        if command -v kdialog >/dev/null 2>&1; then
            q=$(kdialog --title "Lumen fragen" \
                --inputbox "Was soll Lumen mit '${target##*/}' machen?" \
                "Fasse den Zweck von $target zusammen." 2>/dev/null) || exit 0
        else
            q=$(zenity --entry --title "Lumen fragen" \
                --text="Was soll Lumen mit '${target##*/}' machen?" 2>/dev/null) || exit 0
        fi
        [ -z "$q" ] && exit 0
        prompt="$q

Kontext: $target"
        mode="fragen"
        ;;

    *)
        echo "Unbekannte Aktion: $action" >&2
        exit 2
        ;;
esac

export LUMEN_PROMPT="$prompt"
export LUMEN_OPENCODE_BIN

# Interactive session with the prompt prefilled: approvals work and the user
# can continue the conversation afterwards.
term_run "$TITLE_PREFIX: $mode ${first##*/}" \
    '"$LUMEN_OPENCODE_BIN" --prompt "$LUMEN_PROMPT" "$PWD"'
