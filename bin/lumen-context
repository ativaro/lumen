#!/usr/bin/env bash
# lumen-context — helper for KDE Dolphin service menus.
# Opens a terminal running opencode with a prefilled prompt about the selected file(s).
#
# Usage:
#   lumen-context <action> <path>...
#   action: open | explain | fix | review | ask
#
# Overridable via environment / config:
#   LUMEN_OPENCODE_BIN      path to the opencode binary (default: auto-detect)
#   LUMEN_TERM     terminal emulator (default: auto-detect)
#   LUMEN_WORKDIR  default working directory (default: ~/Documents/work)

set -euo pipefail

# ---- configuration --------------------------------------------------------
LUMEN_OPENCODE_BIN="${LUMEN_OPENCODE_BIN:-$(command -v opencode || echo "$HOME/.opencode/bin/opencode")}"
LUMEN_TERM="${LUMEN_TERM:-$(command -v alacritty || command -v konsole || command -v xterm)}"
LUMEN_WORKDIR="${LUMEN_WORKDIR:-$HOME/Documents/work}"
TERM_BIN="$(command -v "$LUMEN_TERM" 2>/dev/null || echo "$LUMEN_TERM")"
TITLE_PREFIX="opencode"

term_run() {
    # $1 = title, $2 = shell command string
    local title="$1" shellcmd="$2"
    case "$(basename "$TERM_BIN")" in
        alacritty) exec "$TERM_BIN" --working-directory "$LUMEN_WORKDIR" -T "$title" -e bash -lc "$shellcmd" ;;
        konsole)   exec "$TERM_BIN" --workdir "$LUMEN_WORKDIR" -p tabtitle="$title" -e bash -lc "$shellcmd" ;;
        xterm)     exec "$TERM_BIN" -T "$title" -e bash -lc "cd '$LUMEN_WORKDIR' && $shellcmd" ;;
        *)         exec "$TERM_BIN" -e bash -lc "cd '$LUMEN_WORKDIR' && $shellcmd" ;;
    esac
}

action="${1:-open}"
shift || true
paths=("$@")

if [ ${#paths[@]} -eq 0 ]; then
    paths=("$PWD")
fi

first="${paths[0]}"
if [ -d "$first" ]; then
    workdir="$first"
    is_dir=1
else
    workdir="$(dirname "$first")"
    is_dir=0
fi
LUMEN_WORKDIR="$workdir"

case "$action" in
    open)
        term_run "$TITLE_PREFIX: ${first##*/}" \
            '"$LUMEN_OPENCODE_BIN" --continue'
        ;;

    explain)
        if [ "$is_dir" = "1" ]; then
            prompt="Erkläre den Inhalt dieses Ordners: Struktur, Zweck und wichtigste Dateien. Ordner: $first"
        else
            prompt="Erkläre diese Datei verständlich: Zweck, Aufbau und wichtige Stellen. Datei: $first"
        fi
        mode="explain"
        ;;

    fix)
        if [ "$is_dir" = "1" ]; then
            prompt="Analysiere diesen Ordner auf Fehler/Bugs und schlage konkrete Fixes vor. Ordner: $first"
        else
            prompt="Analysiere diese Datei auf Fehler/Bugs und schlage konkrete Fixes vor. Datei: $first"
        fi
        mode="fix"
        ;;

    review)
        prompt="Reviewe die aktuellen git-Änderungen in diesem Repository (git diff + git status). Fasse Probleme und Verbesserungen zusammen. Verzeichnis: $workdir"
        mode="review"
        ;;

    ask)
        target="$first"
        if command -v kdialog >/dev/null 2>&1; then
            q=$(kdialog --title "opencode fragen" \
                --inputbox "Was soll opencode mit '${target##*/}' machen?" \
                "Fasse den Zweck von $target zusammen." 2>/dev/null) || exit 0
        else
            q=$(zenity --entry --title "opencode fragen" \
                --text="Was soll opencode mit '${target##*/}' machen?" 2>/dev/null) || exit 0
        fi
        [ -z "$q" ] && exit 0
        prompt="$q

Kontext: $target"
        mode="ask"
        ;;

    *)
        echo "Unbekannte Aktion: $action" >&2
        exit 2
        ;;
esac

export LUMEN_PROMPT="$prompt"
export LUMEN_OPENCODE_BIN

term_run "$TITLE_PREFIX: $mode ${first##*/}" \
    '"$LUMEN_OPENCODE_BIN" run --continue "$LUMEN_PROMPT"; printf "\n--- Fertig. Enter zum Schließen. ---\n"; read -r _'
