#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
for main in "$SELF_DIR/../files/settings_dialog.py" "$SELF_DIR/../share/lumen/files/settings_dialog.py" /usr/share/lumen/files/settings_dialog.py; do
    if [ -f "$main" ]; then exec /usr/bin/python3 "$main" "$@"; fi
done
echo 'Lumen: Die Einstellungen wurden nicht gefunden.' >&2
exit 1
