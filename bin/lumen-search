#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
for main in "$SELF_DIR/../files/lumen_search.py" "$SELF_DIR/../share/lumen/files/lumen_search.py" /usr/share/lumen/files/lumen_search.py; do
    if [ -f "$main" ]; then exec /usr/bin/python3 "$main" "$@"; fi
done
echo 'Lumen: Die Suche wurde nicht gefunden.' >&2
exit 1
