#!/usr/bin/env bash
set -euo pipefail
# A warm search only needs a D-Bus call, not another Qt application and supervisor.
if [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$1" = --voice ]; }; then
    voice=false
    if [ "${1:-}" = --voice ]; then voice=true; fi
    if command -v qdbus6 >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1 &&
        timeout 2 qdbus6 org.lumen.Desktop /Lumen org.lumen.Desktop.ActivateSearch "$voice" >/dev/null 2>&1; then
        exit 0
    fi
fi
SELF_DIR="$(dirname "$(readlink -f "$0")")"
export LUMEN_BIN_DIR="$SELF_DIR"
for main in "$SELF_DIR/../files/search_qml.py" "$SELF_DIR/../share/lumen/files/search_qml.py" /usr/share/lumen/files/search_qml.py; do
    if [ -f "$main" ]; then exec "$SELF_DIR/lumen-python" "$main" "$@"; fi
done
echo 'Lumen: Die Suche wurde nicht gefunden.' >&2
exit 1
