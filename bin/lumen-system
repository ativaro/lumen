#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
export LUMEN_BIN_DIR="$SELF_DIR"
for main in "$SELF_DIR/../files/system_app.py" "$SELF_DIR/../share/lumen/files/system_app.py" /usr/share/lumen/files/system_app.py; do
    if [ -f "$main" ]; then exec "$SELF_DIR/lumen-python" "$main" "$@"; fi
done
echo 'Lumen System wurde nicht gefunden. Bitte die Installation prüfen.' >&2
exit 1
