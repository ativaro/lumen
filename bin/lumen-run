#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
for main in "$SELF_DIR/../files/lumen_background.py" "$SELF_DIR/../share/lumen/files/lumen_background.py" /usr/share/lumen/files/lumen_background.py; do
    if [[ -f "$main" ]]; then exec "$SELF_DIR/lumen-python" "$main" "$@"; fi
done
echo 'Lumen-Analyse ist nicht installiert.' >&2
exit 1
