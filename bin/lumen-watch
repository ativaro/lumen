#!/usr/bin/env bash
# lumen-watch — system watchdog with automatic opencode analysis.
#
# Checks for common problems; on findings it:
#   1. sends a desktop notification,
#   2. runs a short opencode analysis automatically (default ON),
#   3. shows the analysis as a second notification and stores a full report,
#   4. offers an "Öffnen" action to open the report in Lumen.
#
# Runs from a systemd user timer (lumen-watch.timer).
# State in ~/.cache/lumen/ to avoid repeat spam (30 min per signature).
#
# Environment:
#   LUMEN_WATCH_ANALYZE=0   disable the automatic opencode analysis
#   LUMEN_WATCH_MODEL=...   override the model used for analysis
#   LUMEN_OPENCODE_BIN               path to the opencode binary

set -uo pipefail

LUMEN_OPENCODE_BIN="${LUMEN_OPENCODE_BIN:-$(command -v opencode || echo "$HOME/.opencode/bin/opencode")}"

CACHE="${LUMEN_STATE:-$HOME/.cache/lumen}"
mkdir -p "$CACHE"
STATE="$CACHE/watch-last"
NOW="$(date +%s)"
NOTIFY=(notify-send -a Lumen -i lumen)

problems=()
detail=""

# 1) failed user + system units (ignore transient app-* launcher units)
failed_user=$(systemctl --user --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | grep -v '^$' | grep -vE '^app-' | head -20)
failed_sys=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | grep -v '^$' | head -20)
if [ -n "$failed_user" ]; then
    problems+=("User-Units fehlgeschlagen")
    detail+="Fehlgeschlagene User-Units:\n$(echo "$failed_user" | sed 's/^/  - /')\n\n"
fi
if [ -n "$failed_sys" ]; then
    problems+=("System-Units fehlgeschlagen")
    detail+="Fehlgeschlagene System-Units:\n$(echo "$failed_sys" | sed 's/^/  - /')\n\n"
fi

# 2) root filesystem almost full (>90%)
rootpct=$(df --output=pcent / 2>/dev/null | tail -1 | tr -dc '0-9')
if [ -n "${rootpct:-}" ] && [ "$rootpct" -ge 90 ]; then
    problems+=("Root fast voll (${rootpct}%)")
    detail+="Root-Dateisystem zu ${rootpct}% belegt.\n\n"
fi

# 3) kernel errors in recent journal
oops=$(journalctl -q -k -p err --since "10 min ago" --no-pager 2>/dev/null | tail -5)
if [ -n "$oops" ]; then
    problems+=("Kernel-Fehler kürzlich")
    detail+="Kernel-Log (err, letzte 10 min):\n$oops\n\n"
fi

# 4) GPU temperature high (>=85C)
if command -v nvidia-smi >/dev/null 2>&1; then
    gt=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -dc '0-9')
    if [ -n "${gt:-}" ] && [ "$gt" -ge 85 ]; then
        problems+=("GPU heiß (${gt}°C)")
        detail+="GPU meldet ${gt}°C.\n\n"
    fi
fi

# Nothing wrong -> exit quietly (and refresh heartbeat)
if [ ${#problems[@]} -eq 0 ]; then
    echo "$NOW" > "$STATE"
    exit 0
fi

signature="$(printf '%s\n' "${problems[@]}" | md5sum | awk '{print $1}')"

# Suppress identical notification within 30 minutes
if [ -f "$STATE" ]; then
    prev_ts=$(cut -d' ' -f1 "$STATE" 2>/dev/null || echo 0)
    prev_sig=$(cut -d' ' -f2 "$STATE" 2>/dev/null || echo "")
    if [ "$prev_sig" = "$signature" ] && [ $((NOW - prev_ts)) -lt 1800 ]; then
        exit 0
    fi
fi

body="$(printf '%s' "${problems[@]}" | paste -sd ', ' -)"

# log raw findings
{
    echo "=== $(date) ==="
    printf '%b' "$detail"
} >> "$CACHE/watch-log.txt"

# --- Automatic opencode analysis (default ON) -------------------------------
report="$CACHE/analysis-$(date +%Y%m%d-%H%M%S).md"
if [ "${LUMEN_WATCH_ANALYZE:-1}" = "1" ] && { [ -x "$LUMEN_OPENCODE_BIN" ] || command -v "$LUMEN_OPENCODE_BIN" >/dev/null 2>&1; }; then

    prompt="Systemwarnung auf diesem Rechner. Analysiere knapp: Ursache + konkreter Fix (max. 8 Zeilen). Fakten:
$(printf '%b' "$detail")"

    model_args=()
    [ -n "${LUMEN_WATCH_MODEL:-}" ] && model_args=(--model "$LUMEN_WATCH_MODEL")

    # run headless, capture plain output.
    # Unset opencode-internal env so a nested invocation behaves like a fresh one.
    analysis=$(env -u OPENCODE -u OPENCODE_PID -u OPENCODE_SERVER_PASSWORD \
        timeout 120 "$(dirname "$(readlink -f "$0")")/lumen-run" "${model_args[@]}" "$prompt" </dev/null 2>/dev/null \
        | sed -e 's/\x1b\[[0-9;]*m//g' | sed '/^[[:space:]]*$/d' | tail -n 20)

    if [ -n "$analysis" ]; then
        {
            echo "# Lumen Analyse — $(date)"
            echo
            echo "**Befund:** $body"
            echo
            printf '%b' "$detail"
            echo
            echo "## Analyse"
            echo
            echo "$analysis"
        } > "$report"
        ln -sf "$report" "$CACHE/latest-analysis.md"

        short=$(printf '%s' "$analysis" | head -c 600)
        chosen=$("${NOTIFY[@]}" -u critical --icon=dialog-warning \
        -A "open=In Lumen öffnen" \
            "⚠ Systemproblem (${#problems[@]})" "$short" 2>/dev/null || true)

        if [ "$chosen" = "open" ]; then
            setsid "$(dirname "$(readlink -f "$0")")/lumen-agent-app" --page system >/dev/null 2>&1 &
        fi
    else
        "${NOTIFY[@]}" -u critical "⚠ Systemproblem (${#problems[@]})" "$body" 2>/dev/null || true
    fi
else
    "${NOTIFY[@]}" -u critical "⚠ Systemproblem (${#problems[@]})" "$body" 2>/dev/null || true
fi

echo "$NOW $signature" > "$STATE"
