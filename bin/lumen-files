#!/usr/bin/env bash
# Compatibility launcher: file management is a page in Lumen.
set -euo pipefail
BIN="$(dirname "$(readlink -f "$0")")"
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then exec "$BIN/lumen" --help; fi
if [[ "${1:-}" == --settings ]]; then exec "$BIN/lumen" --page settings; fi
if [[ -n "${1:-}" ]]; then
    TARGET="$1"
    if [[ "$TARGET" == file:* ]]; then
        TARGET="$(/usr/bin/python3 -c 'import sys; from urllib.parse import urlsplit,unquote; print(unquote(urlsplit(sys.argv[1]).path))' "$TARGET")"
    fi
    exec "$BIN/lumen" --page files --location "$TARGET"
fi
exec "$BIN/lumen" --page files
