#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
for main in "$SELF_DIR/../files/lumen_desktop_setup.py" "$SELF_DIR/../share/lumen/files/lumen_desktop_setup.py"; do
    if [ -f "$main" ]; then exec "$SELF_DIR/lumen-python" "$main" "$@"; fi
done
echo 'Lumen: Desktop-Einrichtung nicht gefunden.' >&2
exit 1
