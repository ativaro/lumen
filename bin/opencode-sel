#!/usr/bin/env bash
# opencode-sel — act on the current text selection (or clipboard).
#
# Usage:
#   opencode-sel explain      # explain the selected text
#   opencode-sel translate    # translate to $OPENCODE_SEL_LANG (default German)
#   opencode-sel fix          # fix grammar/spelling, copy result back
#   opencode-sel summarize    # summarize
#   opencode-sel "<custom>"   # custom instruction
#
# Text source: primary selection if available, else the clipboard.
#
# Env: OPENCODE_BIN, OPENCODE_TERM, OPENCODE_WORKDIR, OPENCODE_SEL_LANG,
#      OPENCODE_SEL_RUNNER (path to opencode-sel-run)

set -euo pipefail

OPENCODE_BIN="${OPENCODE_BIN:-$(command -v opencode || echo "$HOME/.opencode/bin/opencode")}"
OPENCODE_TERM="${OPENCODE_TERM:-$(command -v alacritty || command -v konsole || command -v xterm)}"
OPENCODE_WORKDIR="${OPENCODE_WORKDIR:-$HOME/Documents/work}"
TERM_BIN="$(command -v "$OPENCODE_TERM" 2>/dev/null || echo "$OPENCODE_TERM")"
LANG_TARGET="${OPENCODE_SEL_LANG:-Deutsch}"

# locate the runtime helper next to this script
SELF_DIR="$(dirname "$(readlink -f "$0")")"
RUNNER="${OPENCODE_SEL_RUNNER:-$SELF_DIR/opencode-sel-run}"
[ -x "$RUNNER" ] || { echo "opencode-sel-run nicht gefunden: $RUNNER" >&2; exit 1; }

action="${1:-explain}"
shift || true

text=""
if command -v wl-paste >/dev/null 2>&1; then
    text="$(wl-paste --primary 2>/dev/null || true)"
    [ -z "$text" ] && text="$(wl-paste 2>/dev/null || true)"
elif command -v xclip >/dev/null 2>&1; then
    text="$(xclip -selection primary -o 2>/dev/null || true)"
    [ -z "$text" ] && text="$(xclip -selection clipboard -o 2>/dev/null || true)"
fi
[ -z "$text" ] && { echo "Keine Auswahl/Zwischenablage gefunden." >&2; exit 1; }

case "$action" in
    explain)   prompt="Erkläre den folgenden Text knapp und verständlich auf Deutsch:"; copy_back=0 ;;
    translate) prompt="Übersetze den folgenden Text nach ${LANG_TARGET}. Gib nur die Übersetzung aus:"; copy_back=1 ;;
    fix)       prompt="Korrigiere Rechtschreibung und Grammatik des folgenden Textes. Gib nur den korrigierten Text aus:"; copy_back=1 ;;
    summarize) prompt="Fasse den folgenden Text in höchstens 3 Sätzen zusammen:"; copy_back=1 ;;
    *)         prompt="$action"; copy_back=0 ;;
esac

export OPENCODE_BIN OPENCODE_PROMPT="$prompt" OPENCODE_TEXT="$text" OPENCODE_COPY_BACK="$copy_back"
export OPENCODE_SEL_RUNNER="$RUNNER"

case "$(basename "$TERM_BIN")" in
    alacritty) exec "$TERM_BIN" --working-directory "$OPENCODE_WORKDIR" -T "opencode: $action" -e "$RUNNER" ;;
    konsole)   exec "$TERM_BIN" --workdir "$OPENCODE_WORKDIR" -p tabtitle="opencode: $action" -e "$RUNNER" ;;
    *)         exec "$TERM_BIN" -e "$RUNNER" ;;
esac
