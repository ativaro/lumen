#!/usr/bin/env bash
# lumen-nightly — nightly system report: writes a dated analysis to the
# agent state dir. Intended for a systemd user timer (e.g. 03:30).
#
# Uses the same MCP-aware opencode run as the watchdog, so it can consult the
# cachyos tools. Kept lightweight: no notification unless something is wrong.

set -uo pipefail

STATE_DIR="${LUMEN_STATE:-$HOME/.cache/lumen}"
mkdir -p "$STATE_DIR"
LUMEN_OPENCODE_BIN="${LUMEN_OPENCODE_BIN:-$(command -v opencode || echo "$HOME/.opencode/bin/opencode")}"

out="$STATE_DIR/nightly-$(date +%Y%m%d).md"
{
    echo "# Nacht-Report — $(date '+%Y-%m-%d %H:%M')"
    echo
    echo "- Kernel: $(uname -r)"
    echo "- Uptime: $(uptime -p 2>/dev/null)"
    echo "- Updates: $(checkupdates 2>/dev/null | wc -l) verfügbar"
    echo "- Disk /: $(df -h / | awk 'NR==2 {print $5}')"
    echo "- Snapshots (root): $(snapper -c root list 2>/dev/null | tail -n +3 | wc -l)"
    echo
} > "$out"

if [ "${LUMEN_NIGHTLY_ANALYZE:-1}" = "1" ] && { [ -x "$LUMEN_OPENCODE_BIN" ] || command -v "$LUMEN_OPENCODE_BIN" >/dev/null 2>&1; }; then
    prompt="Erstelle einen knappen Nacht-Report (max. 10 Zeilen). Prüfe: fehlgeschlagene Units, Speicherplatz, verfügbare Updates, auffällige Logs. Nenne nur Risiken und Empfehlungen. Deutsch. Fakten:
$(cat "$out")"
    analysis="$(env -u OPENCODE -u OPENCODE_PID timeout 150 "$(dirname "$(readlink -f "$0")")/lumen-run" "$prompt" </dev/null 2>/dev/null \
        | sed -e 's/\x1b\[[0-9;]*m//g' | sed '/^[[:space:]]*$/d' | tail -n 15)"
    { echo "## Analyse"; echo; echo "${analysis:-(keine Analyse)}"; } >> "$out"
    ln -sf "$out" "$STATE_DIR/latest-nightly.md"
fi

echo "Nacht-Report: $out"
