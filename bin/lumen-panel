#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
export LUMEN_BIN_DIR="$SELF_DIR"
# Opening Search does not need the task catalogue or a Python panel helper.
if [ "$#" -eq 1 ] && [ -x "$SELF_DIR/lumen-search" ]; then
    case "$1" in
        --search) exec "$SELF_DIR/lumen-search" ;;
        --voice) exec "$SELF_DIR/lumen-search" --voice ;;
    esac
fi
for helper in "$SELF_DIR/../files/lumen_panel.py" "$SELF_DIR/../share/lumen/files/lumen_panel.py" /usr/share/lumen/files/lumen_panel.py; do
    if [ -f "$helper" ]; then exec "$SELF_DIR/lumen-python" "$helper" "$@"; fi
done
echo 'Lumen: Panel-Helfer fehlt.' >&2
exit 1
