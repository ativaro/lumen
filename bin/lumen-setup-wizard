#!/usr/bin/env bash
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
for main in "$SELF_DIR/../files/setup_dialog.py" "$SELF_DIR/../share/lumen/files/setup_dialog.py"; do
    if [ -f "$main" ]; then exec "$SELF_DIR/lumen-python" "$main" "$@"; fi
done
echo 'Lumen: Einrichtungsassistent nicht gefunden.' >&2
exit 1
