#!/usr/bin/env bash
# Launch the native Lumen application from a checkout or installation.
set -euo pipefail
SELF_DIR="$(dirname "$(readlink -f "$0")")"
for main in "$SELF_DIR/../agent-app/main.py" "$SELF_DIR/../share/lumen/agent-app/main.py" /usr/share/lumen/agent-app/main.py; do
    if [ -f "$main" ]; then
        export LUMEN_BIN_DIR="$SELF_DIR"
        exec /usr/bin/python3 "$main" "$@"
    fi
done
echo 'Lumen: Die Anwendung wurde nicht gefunden. Bitte die Installation prüfen.' >&2
exit 1
